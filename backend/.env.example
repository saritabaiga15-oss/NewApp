# Honour Your Mentor - Backend Environment Variables
PORT=8080
SPRING_PROFILES_ACTIVE=supabase

# Supabase PostgreSQL Connection
# You can find these in your Supabase Dashboard -> Project Settings -> Database
SPRING_DATASOURCE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# Or using the Supabase Connection Pooler (recommended for serverless/high-concurrency):
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.YOUR_PROJECT_REF
# SPRING_DATASOURCE_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# JWT Secret (at least 256 bits)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
