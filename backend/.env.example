# Honour Your Mentor - Backend Environment Variables
#
# Copy this file to `backend/.env` (git-ignored) and fill in real values.
# The backend loads backend/.env automatically (see application.properties).
# NEVER put real passwords or secrets in this example file: it is committed.

PORT=8080
SPRING_PROFILES_ACTIVE=neon

# Neon PostgreSQL (use the *pooler* host; prepareThreshold=0 is required for the pooler)
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR-ENDPOINT-pooler.REGION.aws.neon.tech:5432/neondb?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=YOUR_NEON_PASSWORD

# Supabase PostgreSQL (alternative)
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# JWT secret (required, at least 32 bytes). Generate your own:
#   openssl rand -base64 48
# Never reuse a value that has been committed anywhere.
JWT_SECRET=

# Outgoing email (optional for local development)
MAIL_ENABLED=false
# MAIL_USERNAME=info@onodem.com
# MAIL_PASSWORD=
