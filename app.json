{
  "expo": {
    "name": "Honour Your Mentor",
    "slug": "honour-your-mentor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mynewapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Honour Your Mentor",
      "shortName": "HonourMentor",
      "themeColor": "#1B4D3E",
      "backgroundColor": "#F8FAFC",
      "display": "standalone",
      "orientation": "any",
      "description": "Remember and celebrate the mentors who shaped your journey."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#04060B",
          "image": "./assets/images/logo.png",
          "imageWidth": 120
        }
      ],
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Honour Your Mentor to record voice memories."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
